{
  "name": "ai-straem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice AI bridge: PBX streaming channel <-> Gemini Live, with tool calling",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.all.json",
    "test": "node --import tsx --test test/*.test.ts",
    "mock": "tsx scripts/mock-pbx.ts",
    "tone": "tsx scripts/make-tone.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "dotenv": "^17.4.2",
    "nodemailer": "10.0.16",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
