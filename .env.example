# ── PBX streaming channel ────────────────────────────────────────────────────
# Paste the same secret into the channel's "סוד אימות" field in the PBX UI.
AUTH_SECRET=change-me-to-a-long-random-string
PORT=8080
HOST=0.0.0.0
WS_PATH=/voice

# TLS: leave both empty when nginx terminates TLS in front (the usual setup).
# Set them to run wss:// directly from Node.
# TLS_CERT_PATH=/etc/letsencrypt/live/ai.example.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/ai.example.com/privkey.pem

# "echo" loops the caller's voice back and never contacts Gemini — use it first.
MODE=bot

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_VOICE=Aoede
GEMINI_LANGUAGE=he-IL
GEMINI_TEMPERATURE=0.7
GEMINI_TRANSCRIPTS=true

# ── Behaviour ───────────────────────────────────────────────────────────────
GREETING=שלום, הגעת למענה הממוחשב של טכנוליין. איך אפשר לעזור?
# SYSTEM_PROMPT_FILE=./prompt.txt
AGENT_EXTENSION=/2
TOOL_TIMEOUT_MS=4000
MAX_CALL_SECONDS=900

# ── Audio tuning ────────────────────────────────────────────────────────────
# Raise SPEECH_THRESHOLD_DBFS (e.g. -40) on a noisy line; lower it if quiet
# callers get cut off. Watch the "transcript" and "barge-in" log lines.
SPEECH_THRESHOLD_DBFS=-45
SPEECH_ONSET_FRAMES=3
SPEECH_HANGOVER_MS=1500
SUPPRESS_SILENCE=true
GATE_BARGE_IN=true
# VAD_SILENCE_MS=700
# VAD_PREFIX_PADDING_MS=300

# ── Debugging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Per-call caller.wav / bot.wav dumps. Leave unset in production.
# RECORD_DIR=./recordings
