# ── PBX streaming channel ────────────────────────────────────────────────────
# Paste the same secret into the channel's "סוד אימות" field in the PBX UI.
AUTH_SECRET=change-me-to-a-long-random-string
PORT=8080
HOST=0.0.0.0
WS_PATH=/voice

# TLS: leave both empty when nginx terminates TLS in front (the usual setup).
# Set them to run wss:// directly from Node.
# TLS_CERT_PATH=/etc/letsencrypt/live/ai.example.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/ai.example.com/privkey.pem

# "echo" loops the caller's voice back and never contacts Gemini — use it first.
MODE=bot

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_VOICE=Aoede
# Leave empty for native-audio models: they reject any explicit code (he-IL
# included) and detect the language from the caller and the prompt.
GEMINI_LANGUAGE=
GEMINI_TEMPERATURE=0.7
GEMINI_TRANSCRIPTS=true

# ── Behaviour ───────────────────────────────────────────────────────────────
GREETING=שלום, הגעת למענה הממוחשב של טכנוליין. איך אפשר לעזור?
# SYSTEM_PROMPT_FILE=./prompt.txt
AGENT_EXTENSION=/2
TOOL_TIMEOUT_MS=4000
MAX_CALL_SECONDS=900
# Demo lookups (orders, balance, branches) answer with made-up data.
# Set false for a real deployment; get_current_time stays either way.
DEMO_TOOLS=true

# ── Blessings ───────────────────────────────────────────────────────────────
# The catalogue is the only source for any blessing the bot speaks.
# BLESSINGS_FILE=./data/blessings.json
# Audit: compares the bot's own transcript against what the catalogue served,
# and logs any blessing language that does not trace back to it.
BLESSING_AUDIT=true
# true logs findings at error level instead of warn — easier to alert on.
BLESSING_AUDIT_STRICT=false

# ── Audio tuning ────────────────────────────────────────────────────────────
# Raise SPEECH_THRESHOLD_DBFS (e.g. -40) on a noisy line; lower it if quiet
# callers get cut off. Watch the "transcript" and "barge-in" log lines.
SPEECH_THRESHOLD_DBFS=-45
SPEECH_ONSET_FRAMES=3
SPEECH_HANGOVER_MS=1500
SUPPRESS_SILENCE=true
GATE_BARGE_IN=true
# VAD_SILENCE_MS=700
# VAD_PREFIX_PADDING_MS=300

# ── Debugging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Per-call recordings: caller.wav, bot.wav, call.wav (both sides, as heard),
# meta.json and report.txt. The request report only links a recording when set.
# RECORD_DIR=./recordings

# ── Request reports by email (SMTP) ────────────────────────────────────────
# Off unless EMAIL_HOST and EMAIL_TO are set. call.wav is attached when
# RECORD_DIR is set. Keep the password here only, never in git.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASS=
# Sender; defaults to EMAIL_USER.
# EMAIL_FROM=
# Fallback recipient for users who did not set their own notify address.
# EMAIL_TO=
# EMAIL_REPLY_TO=

# ── Management web app ──────────────────────────────────────────────────────
# Served at / on the same port. Users, contacts, instructions and the request
# history live in one SQLite file.
DB_PATH=./db/ai-straem.sqlite
# Creates the first admin on an empty database (bot mode); ignored afterwards.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Session cookies are Secure (HTTPS only). Set false only for local plain-http testing.
# SECURE_COOKIES=true
